{
  "name": "@zhangwenlei1404/dsh-theme-desert-dusk",
  "version": "1.0.0",
  "description": "大漠孤烟直，长河落日圆 —— a desert-dusk theme with geese heading south over the long river, for the Harness Web GUI",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangwenlei1404/dsh-theme-desert-dusk.git"
  },
  "homepage": "https://github.com/zhangwenlei1404/dsh-theme-desert-dusk#readme",
  "bugs": {
    "url": "https://github.com/zhangwenlei1404/dsh-theme-desert-dusk/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "desert",
    "wallpaper"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon-180.png"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
